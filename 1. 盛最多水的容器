class Solution:
    def maxArea(self, height: List[int]) -> int:
        left = 0
        right = len(height)-1
        max_water = 0
        while left < right:
            width = right - left
            posible_height = min(height[left], height[right])
            current_volumn = posible_height * width
            if current_volumn > max_water:
                max_water = current_volumn
            if height[left] < height[right]:
                left += 1
            else:
                right -= 1
        return max_water
