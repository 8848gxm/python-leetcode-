输入：height = [1,1]
输出：1""""

class Solution:
    def maxArea(self, height: List[int]) -> int:
#==================              下面使用双指针法            =========================
        n = len(height)
        left = 0
        right = n-1
        max_water = 0
        while left < right:
            width = right - left
            height_suitable = min(height[left],height[right])
            current_water = width * height_suitable
            if current_water >= max_water:
                max_water = current_water
            if height[left] < height[right]:
                left += 1
            else:
                right -= 1
        return max_water

