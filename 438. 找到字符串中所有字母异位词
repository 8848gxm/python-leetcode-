class Solution:
    def minSubArrayLen(self, target: int, nums: List[int]) -> int:
        left = 0           # 左指针
        max_len = 0        # 最长长度
        total_sumup = 0
        length = float('inf')   #表示初始值设置为无穷大
        for right in range(len(nums)):
            total_sumup += nums[right]

            while total_sumup >= target:
                total_sumup -= nums[left]
                length = min(length,right -left + 1)
                left += 1
        return 0 if length == float('inf') else length
