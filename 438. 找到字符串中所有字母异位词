class Solution:
    def minSubArrayLen(self, target: int, nums: List[int]) -> int:
        left = 0
        length = float('inf')  #表示初始化的值是无穷大
        n = len(nums)
        s = 0
        for right in range(n):
            s += nums[right]

            while s >= target:
                s -= nums[left]
                length = min(length,right-left + 1)
                left += 1
        return 0 if length == float('inf') else length
